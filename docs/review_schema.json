{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["Shop_ID", "product_id", "review_id", "user_name", "rating", "review_time", "review_text", "has_image"],
    "properties": {
      "Shop_ID": {"type": "string"},
      "product_id": {"type": "string", "pattern": "^sp_"},
      "review_id": {"type": "string", "pattern": "^rv_"},
      "user_name": {"type": "string"},
      "rating": {"type": "number", "minimum": 1, "maximum": 5},
      "review_time": {"type": "string", "format": "date"},
      "review_text": {"type": ["string", "null"]},
      "has_image": {"type": "integer", "enum": [0, 1]}
    }
  }
}
